# --- Database (Prisma) ---
DATABASE_URL=postgresql://USER@localhost:5432/cocodeditor_v2_dev
DIRECT_URL=postgresql://USER@localhost:5432/cocodeditor_v2_dev
# --- Supabase Auth (production verifies via JWKS at ${SUPABASE_URL}/auth/v1/.well-known/jwks.json) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still on the legacy HS256 shared secret. Never use the test placeholder in production.
SUPABASE_JWT_SECRET=
# --- Servers ---
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COLLAB_PORT=1234
COLLAB_INTERNAL_URL=http://127.0.0.1:1234
COLLAB_INTERNAL_SECRET=
REDIS_URL=redis://127.0.0.1:6379
# --- Judge0 (RapidAPI CE or self-hosted) ---
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
JUDGE0_AUTH_TOKEN=
EXEC_TIMEOUT_MS=20000
WORKER_CONCURRENCY=4
COLLAB_DEBOUNCE_MS=2000
COLLAB_MAX_DEBOUNCE_MS=3000
